{
  "expo": {
    "name": "Central",
    "slug": "front-end",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/central-logo-0.40x.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/central-logo-0.40x.png",
      "bundleIdentifier": "com.garox.lee.gl.frontend",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/central-logo-0.40x.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.garox.lee.gl.frontend",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131314",
          "image": "./assets/images/central-logo-1.00x.png",
          "imageWidth": 150
        }
      ],
      "./plugins/with-no-nav-contrast.js",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/central-logo-white-1.00x.png",
          "color": "#3B82F6",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Central to scan QR codes to add counterparties."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9955b6ec-9494-4399-9849-db48ec6421c8"
      }
    },
    "owner": "garox.lee.gl",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9955b6ec-9494-4399-9849-db48ec6421c8"
    }
  }
}
